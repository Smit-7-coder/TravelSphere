<%@ Page Language="C#" AutoEventWireup="true"
    CodeBehind="About.aspx.cs"
    Inherits="TravelSphere.Admin.About"
    MasterPageFile="~/Admin/Admin.Master" %>


<asp:Content ID="Content1"
    ContentPlaceHolderID="head"
    runat="server">

    <link href="../Assets/Admincss/about.css"
        rel="stylesheet" />

</asp:Content>


<asp:Content ID="Content2"
    ContentPlaceHolderID="MainContent"
    runat="server">

    <div class="admin-about-page">


        <!-- ==========================================
             PAGE HEADER
        =========================================== -->

        <section class="about-header">

            <div class="header-content">

                <span class="page-label">
                    TRAVELSPHERE ADMIN
                </span>

                <h1>
                    About TravelSphere
                </h1>

                <p>
                    A centralized travel management platform
                    designed to simplify travel planning,
                    package management and booking operations.
                </p>

            </div>


            <div class="header-badge">

                <div class="badge-icon">
                    TS
                </div>

                <div>

                    <strong>
                        TravelSphere
                    </strong>

                    <span>
                        Admin Panel
                    </span>

                </div>

            </div>

        </section>


        <!-- ==========================================
             PLATFORM OVERVIEW
        =========================================== -->

        <section class="overview-section">

            <div class="section-heading">

                <span>
                    PLATFORM OVERVIEW
                </span>

                <h2>
                    Everything Managed
                    <strong>In One Place</strong>
                </h2>

            </div>


            <div class="overview-content">

                <div class="overview-text">

                    <p>
                        TravelSphere is a centralized travel
                        platform that helps travellers discover
                        destinations, explore travel packages,
                        plan their budgets and manage bookings.
                    </p>

                    <p>
                        The Admin Panel provides administrators
                        with the tools required to manage the
                        platform's travel packages, bookings and
                        other important information.
                    </p>

                    <p>
                        The goal is to keep travel information
                        organized and provide a smooth experience
                        for both travellers and administrators.
                    </p>

                </div>


                <div class="overview-highlight">

                    <span>
                        ADMIN ROLE
                    </span>

                    <h3>
                        Manage.
                        Monitor.
                        Maintain.
                    </h3>

                    <p>
                        Keep TravelSphere's information,
                        packages and bookings organized.
                    </p>

                </div>

            </div>

        </section>


        <!-- ==========================================
             MANAGEMENT AREAS
        =========================================== -->

        <section class="management-section">

            <div class="section-heading">

                <span>
                    ADMIN MANAGEMENT
                </span>

                <h2>
                    Core Management
                    <strong>Areas</strong>
                </h2>

            </div>


            <div class="management-grid">


                <!-- PACKAGE -->

                <div class="management-card">

                    <div class="management-icon">
                        📦
                    </div>

                    <div>

                        <h3>
                            Package Management
                        </h3>

                        <p>
                            Create, update and maintain travel
                            package information including
                            destinations, duration and pricing.
                        </p>

                    </div>

                </div>


                <!-- BOOKINGS -->

                <div class="management-card">

                    <div class="management-icon">
                        📋
                    </div>

                    <div>

                        <h3>
                            Booking Management
                        </h3>

                        <p>
                            Monitor customer bookings and keep
                            track of booking dates, packages,
                            amounts and booking status.
                        </p>

                    </div>

                </div>


                <!-- USERS -->

                <div class="management-card">

                    <div class="management-icon">
                        👤
                    </div>

                    <div>

                        <h3>
                            User Management
                        </h3>

                        <p>
                            Maintain traveller information and
                            monitor user activity across the
                            TravelSphere platform.
                        </p>

                    </div>

                </div>


                <!-- DESTINATIONS -->

                <div class="management-card">

                    <div class="management-icon">
                        🌍
                    </div>

                    <div>

                        <h3>
                            Destination Management
                        </h3>

                        <p>
                            Organize destination information and
                            ensure travellers receive useful and
                            updated travel details.
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- ==========================================
             ADMIN RESPONSIBILITIES
        =========================================== -->

        <section class="responsibility-section">

            <div class="responsibility-card">

                <div class="responsibility-number">
                    01
                </div>

                <span>
                    MAINTAIN
                </span>

                <h3>
                    Keep Information Updated
                </h3>

                <p>
                    Maintain accurate package, destination and
                    travel information so that travellers can
                    make informed decisions.
                </p>

            </div>


            <div class="responsibility-card">

                <div class="responsibility-number">
                    02
                </div>

                <span>
                    MONITOR
                </span>

                <h3>
                    Manage Booking Activity
                </h3>

                <p>
                    Monitor booking activity and keep booking
                    information organized for smooth platform
                    operations.
                </p>

            </div>


            <div class="responsibility-card">

                <div class="responsibility-number">
                    03
                </div>

                <span>
                    SUPPORT
                </span>

                <h3>
                    Maintain Platform Experience
                </h3>

                <p>
                    Ensure that important travel information
                    remains organized and accessible throughout
                    the platform.
                </p>

            </div>

        </section>


        <!-- ==========================================
             PLATFORM STATS
        =========================================== -->

        <section class="stats-section">

            <div class="stat-item">

                <strong>
                    100+
                </strong>

                <span>
                    Destinations
                </span>

            </div>


            <div class="stat-divider"></div>


            <div class="stat-item">

                <strong>
                    50+
                </strong>

                <span>
                    Travel Packages
                </span>

            </div>


            <div class="stat-divider"></div>


            <div class="stat-item">

                <strong>
                    24/7
                </strong>

                <span>
                    Platform Access
                </span>

            </div>


            <div class="stat-divider"></div>


            <div class="stat-item">

                <strong>
                    1
                </strong>

                <span>
                    Centralized Platform
                </span>

            </div>

        </section>


        <!-- ==========================================
             SYSTEM INFORMATION
        =========================================== -->

        <section class="system-info">

            <div>

                <span class="info-label">
                    SYSTEM INFORMATION
                </span>

                <h2>
                    TravelSphere Admin Panel
                </h2>

                <p>
                    Administrative interface for managing
                    TravelSphere travel platform operations.
                </p>

            </div>


            <div class="info-details">

                <div>
                    <span>Project</span>
                    <strong>TravelSphere</strong>
                </div>

                <div>
                    <span>Panel</span>
                    <strong>Administrator</strong>
                </div>

                <div>
                    <span>Version</span>
                    <strong>1.0</strong>
                </div>

            </div>

        </section>

    </div>

</asp:Content>