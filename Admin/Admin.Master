<%@ Master Language="C#" AutoEventWireup="true"
    CodeBehind="Admin.master.cs"
    Inherits="TravelSphere.Admin.Admin" %>

<!DOCTYPE html>

<html>

<head runat="server">

    <!-- Browser title -->
    <title>TravelSphere Admin</title>


    <!-- =====================================================
         BOOTSTRAP ICONS
         Used for sidebar icons such as Dashboard, Packages,
         Bookings, About and Logout.
         ===================================================== -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <style>

        /* =====================================================
           GLOBAL RESET
           Removes default browser margin and padding.
           box-sizing makes width/height calculations easier.
           ===================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }


        /* =====================================================
           BODY
           Background used behind the admin content.
           ===================================================== */

        body {
            background-color: #eeeeee;
        }


        /* =====================================================
           ADMIN CONTAINER
           Holds the sidebar and the main page content.
           ===================================================== */

        .admin-container {
            display: flex;
            min-height: 100vh;
        }


        /* =====================================================
           SIDEBAR
           Fixed sidebar that stays on the left side of the
           screen while the page content is displayed beside it.
           ===================================================== */

        .sidebar {

            width: 185px;
            min-height: 100vh;

            background-color: #124d3c;
            color: white;

            position: fixed;

            left: 0;
            top: 0;
            bottom: 0;

            display: flex;
            flex-direction: column;

            z-index: 1000;
        }


        /* =====================================================
           LOGO / BRAND SECTION
           ===================================================== */

        .logo-section {
            padding: 20px 18px 15px;
        }


        .logo-section h2 {

            font-size: 18px;

            text-align: center;

            margin-bottom: 12px;
        }


        .logo-section p {

            font-size: 10px;

            line-height: 1.5;

            color: #d9e6e1;

            text-align: center;
        }


        /* =====================================================
           SIDEBAR DIVIDER
           ===================================================== */

        .sidebar-line {

            height: 1px;

            background-color: rgba(255, 255, 255, 0.4);

            margin: 5px 15px 15px;
        }


        /* =====================================================
           MENU
           Contains all navigation links.
           ===================================================== */

        .menu {

            display: flex;

            flex-direction: column;

            gap: 5px;
        }


        /* =====================================================
           MENU ITEM
           Common style for Dashboard, Packages, Bookings
           and About Us links.
           ===================================================== */

        .menu-item {

            height: 42px;

            display: flex;

            align-items: center;

            padding: 0 20px;

            color: white;

            text-decoration: none;

            font-size: 12px;

            border-radius: 8px;

            margin-right: 2px;

            transition:
                background-color 0.2s ease,
                color 0.2s ease;
        }


        /* =====================================================
           MENU HOVER
           Changes the appearance when the mouse is over a link.
           ===================================================== */

        .menu-item:hover {

            background-color: rgba(255, 255, 255, 0.08);

            color: white;

            text-decoration: none;
        }


        /* =====================================================
           ACTIVE MENU
           JavaScript adds the "active" class to the menu item
           matching the current page.
           ===================================================== */

        .menu-item.active {

            background-color: #2f9469;

            color: white;
        }


        /* =====================================================
           MENU ICON
           ===================================================== */

        .menu-icon {

            width: 28px;

            font-size: 16px;

            margin-right: 9px;

            text-align: center;

            flex-shrink: 0;
        }


        /* =====================================================
           LOGOUT SECTION
           margin-top:auto pushes this section to the bottom
           of the sidebar.
           ===================================================== */

        .logout-section {

            margin-top: auto;

            padding: 15px;
        }


        /* =====================================================
           LOGOUT DIVIDER
           ===================================================== */

        .logout-line {

            height: 1px;

            background-color: rgba(255, 255, 255, 0.4);

            margin-bottom: 18px;
        }


        /* =====================================================
           LOGOUT LINK
           
           Currently this is only a UI link.
           Logout functionality will be added later.
           ===================================================== */

        .logout {

            display: flex;

            align-items: center;

            color: white;

            text-decoration: none;

            font-size: 11px;

            padding-left: 18px;

            transition:
                opacity 0.2s ease,
                color 0.2s ease;
        }


        .logout:hover {

            color: white;

            text-decoration: none;

            opacity: 0.75;
        }


        /* =====================================================
           LOGOUT ICON
           ===================================================== */

        .logout-icon {

            width: 28px;

            font-size: 18px;

            margin-right: 10px;

            text-align: center;
        }


        /* =====================================================
           MAIN CONTENT
           
           The sidebar is fixed at 185px, so the main content
           needs a 185px left margin to avoid going underneath it.
           ===================================================== */

        .main-content {

            margin-left: 185px;

            width: calc(100% - 185px);

            min-height: 100vh;
        }


        /* =====================================================
           RESPONSIVE DESIGN
           
           When the screen becomes smaller, the sidebar becomes
           150px wide and the main content adjusts accordingly.
           ===================================================== */

        @media screen and (max-width: 800px) {

            .sidebar {

                width: 150px;
            }


            .main-content {

                margin-left: 150px;

                width: calc(100% - 150px);
            }


            .menu-item {

                padding: 0 12px;
            }


            .logo-section {

                padding-left: 10px;

                padding-right: 10px;
            }


            .menu-icon {

                margin-right: 5px;
            }


            .logout {

                padding-left: 8px;
            }

        }

    </style>


    <!-- =====================================================
         PAGE-SPECIFIC CSS
         
         Every Admin page can put its own CSS inside this
         ContentPlaceHolder.

         Example:
         AdminDeshboard.aspx -> deshboard.css
         ManagePackages.aspx -> mpackage.css
         ===================================================== -->

    <asp:ContentPlaceHolder
        ID="head"
        runat="server">
    </asp:ContentPlaceHolder>

</head>


<body>

<form id="form1" runat="server">

    <div class="admin-container">


        <!-- =================================================
             SIDEBAR
             Common sidebar used by all Admin pages.
             ================================================= -->

        <aside class="sidebar">


            <!-- =================================================
                 LOGO / BRAND
                 ================================================= -->

            <div class="logo-section">

                <h2>
                    TravelSphere
                </h2>

                <p>
                    Your best companion to travel
                    around the world
                </p>

            </div>


            <!-- Sidebar divider -->

            <div class="sidebar-line"></div>


            <!-- =================================================
                 NAVIGATION MENU
                 ================================================= -->

            <nav class="menu">


                <!-- ===============================
                     DASHBOARD
                     =============================== -->

                <a href="AdminDeshboard.aspx"
                   class="menu-item">

                    <i class="bi bi-grid-1x2-fill menu-icon"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <!-- ===============================
                     PACKAGES
                     =============================== -->

                <a href="ManagePackages.aspx"
                   class="menu-item">

                    <i class="bi bi-box-seam-fill menu-icon"></i>

                    <span>
                        Packages
                    </span>

                </a>


                <!-- ===============================
                     BOOKINGS
                     =============================== -->

                <a href="ManageBookings.aspx"
                   class="menu-item">

                    <i class="bi bi-calendar-check-fill menu-icon"></i>

                    <span>
                        Bookings
                    </span>

                </a>


                <!-- ===============================
                     ABOUT
                     =============================== -->

                <a href="About.aspx"
                   class="menu-item">

                    <i class="bi bi-info-circle-fill menu-icon"></i>

                    <span>
                        About Us
                    </span>

                </a>

            </nav>


            <!-- =================================================
                 LOGOUT
                 
                 UI ONLY FOR NOW.
                 The "#" prevents navigation.
                 Actual logout functionality can be added later.
                 ================================================= -->

            <div class="logout-section">

                <div class="logout-line"></div>

                <a href="#"
                   class="logout">

                    <i class="bi bi-box-arrow-right logout-icon"></i>

                    <span>
                        Log Out
                    </span>

                </a>

            </div>

        </aside>


        <!-- =================================================
             MAIN CONTENT
             
             Individual Admin pages appear here.

             Example:
             Dashboard content
             Packages content
             Bookings content
             ================================================= -->

        <main class="main-content">

            <asp:ContentPlaceHolder
                ID="MainContent"
                runat="server">
            </asp:ContentPlaceHolder>

        </main>

    </div>

</form>


<!-- =========================================================
     ACTIVE SIDEBAR SCRIPT

     This script checks the current page name and compares it
     with each sidebar link.

     Example:

     Current page:
     ManagePackages.aspx

     Matching link:
     ManagePackages.aspx

     That menu item receives:
     class="menu-item active"

     This is why the Packages menu becomes green.
     ========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        /* Get the current page name from the browser URL */

        var currentPage = window.location.pathname
            .split("/")
            .pop()
            .toLowerCase();


        /* Find all sidebar menu items */

        var menuItems =
            document.querySelectorAll(".menu-item");


        /* Check every menu item */

        menuItems.forEach(function (item) {

            /* Get the href of the current menu link */

            var link =
                item.getAttribute("href");


            /* If the link does not have an href,
               skip it. */

            if (!link) {

                return;
            }


            /* Get only the page name from the href */

            var linkPage = link
                .split("/")
                .pop()
                .toLowerCase();


            /* Remove active class first */

            item.classList.remove("active");


            /* Add active class if this is the current page */

            if (linkPage === currentPage) {

                item.classList.add("active");
            }

        });

    });

</script>


</body>

</html>