<%@ Page Language="C#"
    MasterPageFile="~/Traveller/Traveller.Master"
    AutoEventWireup="true"
    CodeBehind="AboutUs.aspx.cs"
    Inherits="TravelSphere.Traveller.AboutUs" %>


<asp:Content ID="Content1"
    ContentPlaceHolderID="head"
    runat="server">

    <link href="../Assets/css/about-us.css"
        rel="stylesheet" />

</asp:Content>


<asp:Content ID="Content2"
    ContentPlaceHolderID="MainContent"
    runat="server">


    <!-- ==========================================
         ABOUT HERO
    =========================================== -->

    <section class="about-hero">


        <div class="about-hero-overlay">
        </div>


        <div class="about-hero-content">

            <span class="hero-label">
                ABOUT TRAVELSPHERE
            </span>


            <h1>
                Travel More.
                <br />
                Experience More.
            </h1>


            <p>
                Your trusted companion for discovering
                destinations, planning trips and creating
                unforgettable travel experiences.
            </p>


        </div>


    </section>


    <!-- ==========================================
         ABOUT INTRODUCTION
    =========================================== -->

    <section class="about-container">


        <div class="about-intro">


            <div class="intro-content">

                <span class="section-label">
                    WHO WE ARE
                </span>


                <h2>
                    Making Travel
                    <span>Simple & Meaningful</span>
                </h2>


                <p>
                    TravelSphere is a centralized travel platform
                    designed to make discovering and planning trips
                    easier for travellers.
                </p>


                <p>
                    From exploring destinations and finding suitable
                    travel packages to planning your budget and
                    managing your bookings, TravelSphere brings
                    important travel services together in one place.
                </p>


                <p>
                    Our goal is to reduce the complexity of travel
                    planning and give travellers a simple,
                    convenient and enjoyable experience.
                </p>


            </div>


            <div class="intro-highlight">


                <div class="quote-icon">
                    “
                </div>


                <h3>
                    Your Journey,
                    <br />
                    Our Platform.
                </h3>


                <p>
                    Discover. Plan. Book. Travel.
                </p>


            </div>


        </div>


        <!-- ==========================================
             WHY TRAVELSPHERE
        =========================================== -->

        <section class="about-section">


            <div class="section-heading">

                <span class="section-label">
                    WHY TRAVELSPHERE
                </span>


                <h2>
                    Everything You Need
                    <span>Before You Travel</span>
                </h2>


                <p>
                    TravelSphere brings useful travel features
                    together to make your journey easier.
                </p>

            </div>


            <div class="feature-grid">


                <!-- FEATURE 1 -->

                <div class="feature-card">

                    <div class="feature-icon">
                        🌍
                    </div>


                    <h3>
                        Explore Destinations
                    </h3>


                    <p>
                        Discover popular destinations and explore
                        places that match your travel interests.
                    </p>

                </div>


                <!-- FEATURE 2 -->

                <div class="feature-card">

                    <div class="feature-icon">
                        🧳
                    </div>


                    <h3>
                        Travel Packages
                    </h3>


                    <p>
                        Explore carefully designed travel packages
                        with useful information about duration,
                        pricing and destinations.
                    </p>

                </div>


                <!-- FEATURE 3 -->

                <div class="feature-card">

                    <div class="feature-icon">
                        ₹
                    </div>


                    <h3>
                        Budget Planner
                    </h3>


                    <p>
                        Estimate your travel expenses and plan your
                        trip according to your budget.
                    </p>

                </div>


                <!-- FEATURE 4 -->

                <div class="feature-card">

                    <div class="feature-icon">
                        ✓
                    </div>


                    <h3>
                        Easy Booking
                    </h3>


                    <p>
                        Book travel packages through a simple and
                        convenient booking process.
                    </p>

                </div>


                <!-- FEATURE 5 -->

                <div class="feature-card">

                    <div class="feature-icon">
                        📋
                    </div>


                    <h3>
                        Manage Your Trips
                    </h3>


                    <p>
                        View your upcoming and previous trips,
                        booking information and traveller details.
                    </p>

                </div>


                <!-- FEATURE 6 -->

                <div class="feature-card">

                    <div class="feature-icon">
                        ❤️
                    </div>


                    <h3>
                        Better Travel Experience
                    </h3>


                    <p>
                        Get the important tools you need to plan
                        your journey from one convenient platform.
                    </p>

                </div>


            </div>


        </section>


